{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karteczki",
  "version": "1.3.1",
  "identifier": "pl.grocjusz.karteczki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Karteczki",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: kimg: http://kimg.localhost; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "grocjusz",
    "category": "Productivity",
    "shortDescription": "Szybkie notatki i karteczki na pulpicie",
    "longDescription": "Karteczki — notatki w stylu Google Keep i Sticky Notes, z synchronizacją przez OneDrive.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Polish"],
        "displayLanguageSelector": false
      }
    }
  }
}
